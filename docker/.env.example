# Copy this file to `docker/.env` and edit values as needed:
#   cp docker/.env.example docker/.env

# ----- bundled compose (docker-compose.yml) -----

# Host port mapped to dlslime-ctrl's HTTP server.
DLSLIME_CTRL_PORT=4479

# Host port mapped to the bundled Redis. Pick something free on your host;
# the default 16379 avoids colliding with a typical local Redis on 6379.
DLSLIME_CTRL_REDIS_HOST_PORT=16379

# Hostname/IP that external PeerAgents will use to reach Redis. Defaults to
# 127.0.0.1 (works only when PeerAgents run on the same host as Docker).
# Set this to your LAN IP / FQDN if PeerAgents run on different machines.
# DLSLIME_CTRL_ADVERTISE_HOST=10.0.0.42

# Rust log level for dlslime-ctrl. One of: error, warn, info, debug, trace.
DLSLIME_CTRL_RUST_LOG=info

# ----- external-redis compose (docker-compose.external-redis.yml) -----

# Point ctrl at an external Redis reachable from the container network.
# DLSLIME_CTRL_REDIS_URL=redis://my-redis.internal:6379

# ----- image source (shared by both compose files) -----

# By default both compose files build the image locally from ctrl.Dockerfile.
# To pull a pre-built image from GitHub Container Registry (GHCR) instead:
# DLSLIME_CTRL_IMAGE=ghcr.io/deeplink-org/dlslime-ctrl:0.1.7
# DLSLIME_CTRL_PULL_POLICY=missing
